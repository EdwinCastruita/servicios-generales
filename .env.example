# URL raíz de tu instancia de Odoo 19 (sin barra final, SIN sub-path como /api/portal)
ODOO_URL=https://tu-empresa.odoo.com

# El login y la creación del ticket se hacen vía el módulo Odoo
# wispi_servicios_generales_api (debe estar instalado en esa base). No
# hace falta configurar el nombre de la base de datos: el módulo lo
# resuelve solo (request.env.cr.dbname), igual que wispi_portal_api.
# El equipo de Helpdesk (team_id) se resuelve automáticamente según la
# compañía del usuario logeado (campo "Serviced Company" de helpdesk.team).

# (Opcional) Google OAuth 2.0 Client ID para el botón "Iniciar sesión con
# Google". Si se deja vacío, el botón no se muestra. Ver instrucciones
# completas en el .env local o en el README del módulo Odoo.
# GOOGLE_CLIENT_ID=
